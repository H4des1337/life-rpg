# LIFE RPG — Environment configuration
# Copy this file to .env and adjust as needed.
# The server must never bind to 0.0.0.0 in production.

# Network binding (loopback only — never 0.0.0.0)
HOST=127.0.0.1
PORT=3000

# Data directory (default: %LOCALAPPDATA%\LIFE_RPG_WEB on Windows)
LIFERPG_DATA_DIR=

# Disable automatic daily backups (set to '1' to disable)
LIFERPG_DISABLE_AUTO_BACKUP=0

# Allow remote hosts (comma-separated hostnames; loopback is always allowed).
# Do NOT set this in production unless you understand the risk.
# Example: LIFERPG_ALLOW_REMOTE_HOSTS=192.168.1.50,localhost
LIFERPG_ALLOW_REMOTE_HOSTS=

# Log level
LOG_LEVEL=info

# Web build output override
LIFERPG_WEB_DIST=

# Migrations directory override
LIFERPG_MIGRATIONS_DIR=
